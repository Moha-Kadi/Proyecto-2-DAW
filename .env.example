# Formato: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
MONGO_URI=enlace_mongo

# JWT autenticacion
# Clave secreta
JWT_SECRET=cambiar-por-valor-secreto-largo
# Algoritmo de firmado (HS256 por defecto)
JWT_ALGORITHM=HS256
# Duracion del token de acceso en minutos
JWT_EXPIRE_MINUTES=60

# Cors
# Origenes permitidos separados por coma
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:80

# API-Football
# Clave de API para API-Football (obligatorio para fixtures/standings)
FOOTBALL_API_KEY=tu-api-key-de-api-football
